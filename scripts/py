#!/bin/sh
# Run the published application; no host Python or uv needed.
set -eu

if ! command -v docker >/dev/null 2>&1; then
    echo 'Docker is required. Install Docker and start its daemon.' >&2
    exit 1
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
config_file=${AI_CHAT_ENV_FILE:-"$script_dir/../.env"}
image=${AI_CHAT_IMAGE:-ghcr.io/cainiaocome/py:latest}

set -- docker run --rm --pull always -it \
    --user "$(id -u):$(id -g)" \
    --env "TERM=${TERM:-xterm-256color}"

# Mount dotenv instead of Docker's --env-file: preserve python-dotenv quoting.
if [ -f "$config_file" ]; then
    config_dir=$(CDPATH='' cd -- "$(dirname -- "$config_file")" && pwd)
    config_file="$config_dir/$(basename -- "$config_file")"
    set -- "$@" --mount "type=bind,source=$config_file,target=/app/.env,readonly"
elif [ -n "${AI_CHAT_ENV_FILE:-}" ]; then
    echo "Configuration file not found: $config_file" >&2
    exit 1
fi

# Pass variable names, never secret values, as command arguments.
if [ "${OLLAMA_API_KEY+x}" = x ]; then
    set -- "$@" --env OLLAMA_API_KEY
fi
if [ "${OLLAMA_MODEL+x}" = x ]; then
    set -- "$@" --env OLLAMA_MODEL
fi

exec "$@" "$image"
